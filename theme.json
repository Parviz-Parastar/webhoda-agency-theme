{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,

    "settings": {
        "appearanceTools": false,
        "useRootPaddingAwareAlignments": false,

        "layout": {
            "contentSize": "760px",
            "wideSize": "1200px"
        },

        "color": {
            "custom": true,
            "customDuotone": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "navy",
                    "color": "#111C32",
                    "name": "Navy"
                },
                {
                    "slug": "ivory",
                    "color": "#F4EBDD",
                    "name": "Ivory"
                },
                {
                    "slug": "gold",
                    "color": "#C6A15B",
                    "name": "Gold"
                },
                {
                    "slug": "turquoise",
                    "color": "#176F70",
                    "name": "Turquoise"
                },
                {
                    "slug": "burgundy",
                    "color": "#8E493C",
                    "name": "Burgundy"
                },
                {
                    "slug": "charcoal",
                    "color": "#29272A",
                    "name": "Charcoal"
                },
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "White"
                }
            ]
        },

        "typography": {
            "customFontSize": true,
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "14px",
                    "name": "کوچک"
                },
                {
                    "slug": "medium",
                    "size": "16px",
                    "name": "معمولی"
                },
                {
                    "slug": "large",
                    "size": "20px",
                    "name": "بزرگ"
                },
                {
                    "slug": "x-large",
                    "size": "28px",
                    "name": "بزرگ‌تر"
                }
            ],
            "fontFamilies": [
                {
                    "slug": "estedad",
                    "name": "Estedad",
                    "fontFamily": "'Estedad', 'Vazirmatn', Tahoma, Arial, sans-serif"
                },
                {
                    "slug": "inter",
                    "name": "Inter",
                    "fontFamily": "'Inter', 'Plus Jakarta Sans', Georgia, serif"
                }
            ]
        }
    },

    "styles": {
        "typography": {
            "fontFamily": "'Estedad', 'Vazirmatn', 'Inter', 'Plus Jakarta Sans', Tahoma, Arial, sans-serif"
        },
        "color": {
            "background": "#F4EBDD",
            "text": "#29272A"
        }
    }
}
